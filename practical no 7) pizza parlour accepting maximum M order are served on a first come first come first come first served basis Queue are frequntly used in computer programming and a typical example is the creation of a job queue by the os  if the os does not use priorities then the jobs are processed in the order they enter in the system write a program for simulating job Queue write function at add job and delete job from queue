#include<stdio.h>
#define MAX 5

int queue[MAX];
int front = -1,rear = -1;

int isFull()
{
    return rear == MAX - 1;
}
int isEmpty()
{
    return front == -1||front>rear;
}
void add(int job)
{
    if(isFull())
    {
        printf("Queue is full. cannot add more jobs:\n");
        return;
    }
 if(front==-1)front=0;
    queue[++rear]=job;
    printf("job%d addad to the queue.\n",job);
}
void deletejob()
{
    if(isEmpty())
    {
        printf("Queue is empty. No jobs to process.\n");
        return;
    }
    printf("Processing job %d...\n",queue[front]);
    front++;
    if(front>rear)
    {
        front = rear = -1;
    }
}
void displyQueue()
{
    if(isEmpty())
    {
        printf("Queue is empty.\n");
        return;
    }
    printf("Current jobs in queue:");
    for(int i = front; i<=rear;i++)
        {
            printf("%d",queue[i]);
        }
    printf("\n");
}
int main()
{
    int choice,job;
    printf("Pizza parlor Job Queue Simulation(MAX%d jobs)\n",MAX);
    while(1)
        {
    printf("\n1.Add job\n2.Process job\n3.Disply jobs\n4.Exit\n");
        printf("Enter your choice:");
        scanf("%d",&choice);

        switch(choice)
            {
                case 1:printf("Enter job number to add: ");
                      scanf("%d",&job);
                      add(job);
                      break;
                case 2:deletejob();
                      break;
                case 3:displyQueue();
                      break;
                case 4:printf("Exiting simulation.\n");
                       return 0;
                default:printf("Invalid choice. Try again.\n");
            }
        }
        return 0;
}

