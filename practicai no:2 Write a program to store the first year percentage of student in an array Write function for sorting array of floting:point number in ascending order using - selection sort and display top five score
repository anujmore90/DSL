#include <stdio.h>

void selectionSort(float arr[], int n) {
    int i, j, minIdx;
    float temp;

    for (i = 0; i < n - 1; i++) {
        minIdx = i;
        for (j = i + 1; j < n; j++) {
            if (arr[j] < arr[minIdx])
                minIdx = j;
        }
        temp = arr[i];
        arr[i] = arr[minIdx];
        arr[minIdx] = temp;
    }
}

void bubbleSort(float arr[], int n) {
    int i, j;
    float temp;

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

void displayTopFive(float arr[], int n) {
    printf("\nTop Five Scores:\n");
    int count = (n >= 5) ? 5 : n;

    for (int i = n - 1; i >= n - count; i--) {
        printf("%.2f\n", arr[i]);
    }
}

int main() {
    int n, choice;

    printf("Enter the number of students: ");
    scanf("%d", &n);

    float percentages[n];

    printf("Enter the percentage of %d students:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%f", &percentages[i]);
    }

    printf("\nChoose sorting method:\n");
    printf("1. Selection Sort\n");
    printf("2. Bubble Sort\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    if (choice == 1) {
        selectionSort(percentages, n);
        printf("Sorted using Selection Sort.\n");
    }
    else if (choice == 2) {
        bubbleSort(percentages, n);
        printf("Sorted using Bubble Sort.\n");
    }
    else {
        printf("Invalid choice.\n");
        return 0;
    }

    displayTopFive(percentages, n);

    return 0;
}

