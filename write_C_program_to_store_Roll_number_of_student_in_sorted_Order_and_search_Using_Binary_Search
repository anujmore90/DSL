#include <stdio.h>

#define MAX 100

void insertSorted(int arr[], int *n, int roll) {
    int i = *n - 1;
    while (i >= 0 && arr[i] > roll) {
        arr[i + 1] = arr[i];
        i--;
    }
    arr[i + 1] = roll;
    (*n)++;
}

int binarySearch(int arr[], int n, int key) {
    int low = 0, high = n - 1;
    while (low <= high) {
        int mid = (low + high) / 2;
        if (arr[mid] == key)
            return mid; 
        else if (arr[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }
    return -1; 
}

void display(int arr[], int n) {
    if (n == 0) {
        printf("No roll numbers stored yet.\n");
        return;
    }

    printf("Stored Roll Numbers (Sorted):\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

int main() {
    int rollNumbers[MAX];
    int n = 0, choice, roll, index;

    do {
        printf("\n--- Student Training Program Menu ---\n");
        printf("1. Insert Roll Number\n");
        printf("2. Search Roll Number\n");
        printf("3. Display Roll Numbers\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                if (n == MAX) {
                    printf("Cannot insert. Array is full.\n");
                } else {
                    printf("Enter roll number to insert: ");
                    scanf("%d", &roll);
                    insertSorted(rollNumbers, &n, roll);
                    printf("Roll number inserted in sorted order.\n");
                }
                break;

            case 2:
                if (n == 0) {
                    printf("No roll numbers to search. Please insert first.\n");
                } else {
                    printf("Enter roll number to search: ");
                    scanf("%d", &roll);
                    index = binarySearch(rollNumbers, n, roll);

                    if (index != -1)
                        printf("Roll number %d attended the training program (Found at index %d).\n", roll, index);
                    else
                        printf("Roll number %d did NOT attend the training program.\n", roll);
                }
                break;

            case 3:
                display(rollNumbers, n);
                break;

            case 4:
                printf("Exiting program. Thank you!\n");
                break;

            default:
                printf("Invalid choice. Please try again.\n");
        }

    } while (choice != 4);

    return 0;
}


